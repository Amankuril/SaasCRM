NODE_ENV=development
PORT=4000

# Local install / docker-compose, or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/zeta_connect

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Frontend URL (used for invite links and CORS)
APP_URL=http://localhost:5173

BCRYPT_ROUNDS=12

# Encrypts WhatsApp access tokens at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Redis for BullMQ job queues
REDIS_URL=redis://127.0.0.1:6379
QUEUE_DRIVER=bullmq
RUN_WORKERS=true

# Public URL Meta can reach for webhooks (use an ngrok/cloudflared tunnel in development)
PUBLIC_API_URL=http://localhost:4000

# `meta` = real WhatsApp Cloud API; `sandbox` = fake provider for local development (no Meta account needed)
WHATSAPP_PROVIDER=meta

# Meta app (developers.facebook.com > your app > App settings / WhatsApp > Configuration)
META_GRAPH_VERSION=v23.0
# WhatsApp Flows JSON version for published forms
META_FLOW_JSON_VERSION=6.3
META_APP_SECRET=
# Embedded Signup ("Connect WhatsApp with Facebook"): App ID + Facebook Login for Business configuration id.
# Leave empty to let businesses connect by pasting credentials only.
META_APP_ID=
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Outgoing email for login verification codes (SMTP). Gmail example: smtp.gmail.com, port 587,
# SMTP_SECURE=false, your address and an App Password. Without SMTP_HOST, development prints
# codes to the server console; production refuses business logins until it is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zeta Connect <no-reply@yourdomain.com>"

# Google Sheets integration (optional). Without these, sheets shared as "Anyone with the link"
# still work. With an OAuth client (console.cloud.google.com > APIs & Services > Credentials,
# Sheets API enabled), private sheets can be connected. Authorized redirect URI:
#   <PUBLIC_API_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seconds between checks of active sheet campaigns for new rows
SHEETS_POLL_SECONDS=60

# AI agent: `anthropic` (Claude) or `sandbox` (fake answers from knowledge snippets, no key needed)
AI_PROVIDER=anthropic
# Optional platform key; each workspace can also add its own key in AI settings
ANTHROPIC_API_KEY=

# Development only: let webhooks and flow HTTP steps call http:// / localhost URLs (refused in production)
ALLOW_PRIVATE_OUTBOUND_URLS=false

# Subscriptions: `razorpay` or `sandbox` (fake checkout, no money moves)
BILLING_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: <PUBLIC_API_URL>/api/webhooks/razorpay (events: subscription.*)
RAZORPAY_WEBHOOK_SECRET=
